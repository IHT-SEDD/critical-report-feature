{
    "name": "lica-laravel-7-8/critical-report",
    "description": "Modul Laporan Nilai Kritis Laboratorium (Critical Report) untuk Laravel 7/8",
    "type": "library",
    "license": "proprietary",
    "keywords": ["laravel", "laboratorium", "critical-report", "laporan", "lis"],
    "require": {
        "php": ">=7.4.2,<8.0",
        "illuminate/support": "^7.0|^8.0",
        "illuminate/console": "^7.0|^8.0",
        "illuminate/database": "^7.0|^8.0",
        "maatwebsite/excel": "^3.1",
        "yajra/laravel-datatables-oracle": "^9.0|^10.0"
    },
    "autoload": {
        "psr-4": {
            "Lica\\CriticalReport\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lica\\CriticalReport\\CriticalReportServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
